{
  "name": "second-brain",
  "productName": "Segundo Cérebro",
  "version": "0.6.65",
  "description": "Segundo Cérebro, da Rangel Tech: agente de IA para desktop com provedores e combos",
  "main": "main.js",
  "author": {
    "name": "Rangel Tech",
    "email": "contato@rangeltech.net"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icones": "electron scripts/gerar-icones.js",
    "router:build": "node scripts/baixar-router.mjs && npm --prefix router install --no-audit --no-fund && npm --prefix router run build && node scripts/pos-build-router.js",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never -c.productName=SegundoCerebro",
    "router:fetch": "node scripts/baixar-router.mjs",
    "dist:ci": "electron-builder --win nsis portable --publish never -c.win.signAndEditExecutable=true",
    "dist:ci:portatil": "electron-builder --win portable --publish never -c.win.signAndEditExecutable=true",
    "dist:ci:nsis": "electron-builder --win nsis --publish never -c.win.signAndEditExecutable=true -c.compression=store",
    "modelo:voz": "node scripts/baixar-modelo-voz.js",
    "icone:dev": "node scripts/icone-dev.js"
  },
  "build": {
    "appId": "net.rangeltech.secondbrain",
    "productName": "Segundo Cérebro",
    "icon": "build/icon.png",
    "files": [
      "mcp-navegador.js",
      "transcricao-worker.js",
      "mcp-midia.js",
      "midia-detalhar.js",
      "mcp-memoria.js",
      "mcp-ias.js",
      "navegador.js",
      "unlimited.js",
      "main.js",
      "preload.js",
      "agent.js",
      "ponte-llm.js",
      "ponte-restaurar.js",
      "roteador.js",
      "skills.js",
      "skills-repo.js",
      "remoto.js",
      "oauth-janela.js",
      "extensao-app.js",
      "native-host.js",
      "editor-video.js",
      "partida-direta.js",
      "ferramentas.js",
      "mcp-editor.js",
      "hermes-instalar.js",
      "relatorio-instalacao.js",
      "caminhos-hermes.js",
      "atualizador.js",
      "autoteste.js",
      "embed-router.js",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Rangel Tech <contato@rangeltech.net>",
      "synopsis": "Agente de IA para desktop",
      "description": "Segundo Cérebro: agente de IA com provedores, combos e a IA Unlimited",
      "artifactName": "Segundo-Cerebro-Linux.${ext}",
      "icon": "build/icon.png"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "Segundo-Cerebro-macOS-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "Segundo Cérebro"
      },
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-"
    },
    "dmg": {
      "title": "Segundo Cérebro ${version}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Segundo-Cerebro-Windows.${ext}",
      "shortcutName": "Segundo Cérebro",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "router/.next/standalone",
        "to": "router",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/better-sqlite3/**"
        ]
      },
      {
        "from": "build/hermes-runtime",
        "to": "hermes-runtime",
        "filter": [
          "*.7z",
          "7za.exe"
        ]
      },
      {
        "from": "skills-globais",
        "to": "skills-globais"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "mcp-navegador.js",
        "to": "mcp-navegador.js"
      },
      {
        "from": "native-host.js",
        "to": "native-host.js"
      },
      {
        "from": "mcp-editor.js",
        "to": "mcp-editor.js"
      },
      {
        "from": "modelos",
        "to": "modelos",
        "filter": [
          "whisper-small/**/*"
        ]
      },
      {
        "from": "build/liberdade-vm.sh",
        "to": "liberdade-vm.sh"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "RangelTech",
        "repo": "second-brain"
      }
    ],
    "portable": {
      "artifactName": "Segundo-Cerebro-Windows-Portatil.${ext}"
    },
    "asarUnpack": [
      "transcricao-worker.js",
      "node_modules/onnxruntime-node/**",
      "node_modules/@huggingface/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "deb": {
      "afterInstall": "build/liberdade-vm.sh"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "electron-updater": "^6.3.9",
    "qrcode-generator": "^1.4.4",
    "ws": "^8.18.0"
  },
  "homepage": "https://github.com/RangelTech/second-brain",
  "repository": {
    "type": "git",
    "url": "https://github.com/RangelTech/second-brain.git"
  }
}
