{
  "name": "second-brain",
  "productName": "Segundo Cérebro",
  "version": "0.3.4",
  "description": "Segundo Cérebro, da Rangel Tech: agente de IA para desktop com provedores e combos",
  "main": "main.js",
  "author": {
    "name": "Rangel Tech",
    "email": "contato@rangeltech.net"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icones": "electron scripts/gerar-icones.js",
    "router:build": "node scripts/baixar-router.mjs && npm --prefix router install --no-audit --no-fund && npm --prefix router run build && node scripts/pos-build-router.js",
    "dist": "electron-builder --win nsis portable --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "router:fetch": "node scripts/baixar-router.mjs",
    "dist:ci": "electron-builder --win nsis portable --publish never -c.win.signAndEditExecutable=true"
  },
  "build": {
    "appId": "net.rangeltech.secondbrain",
    "productName": "Segundo Cérebro",
    "icon": "build/icon.png",
    "files": [
      "mcp-navegador.js",
      "navegador.js",
      "unlimited.js",
      "main.js",
      "preload.js",
      "agent.js",
      "skills.js",
      "skills-repo.js",
      "embed-router.js",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Rangel Tech <contato@rangeltech.net>",
      "synopsis": "Agente de IA para desktop",
      "description": "Segundo Cérebro: agente de IA com provedores, combos e a IA Unlimited",
      "artifactName": "Segundo-Cerebro-${version}-linux-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "Segundo-Cerebro-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "title": "Segundo Cérebro ${version}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Segundo-Cerebro-Instalador-${version}.${ext}",
      "shortcutName": "Segundo Cérebro",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "router/.next/standalone",
        "to": "router",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/better-sqlite3/**"
        ]
      },
      {
        "from": "skills-globais",
        "to": "skills-globais"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "mcp-navegador.js",
        "to": "mcp-navegador.js"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "RangelTech",
        "repo": "second-brain"
      }
    ],
    "portable": {
      "artifactName": "Segundo-Cerebro-Portatil-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "homepage": "https://github.com/RangelTech/second-brain",
  "repository": {
    "type": "git",
    "url": "https://github.com/RangelTech/second-brain.git"
  }
}