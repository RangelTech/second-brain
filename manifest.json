{
  "manifest_version": 3,
  "name": "Cérebro Pro no Chrome",
  "description": "Deixa o Cérebro Pro usar o seu Chrome, com as suas contas já abertas. Sem login aqui: a conta vem do aplicativo ou do site.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA0Jz7p9p0SeDqrk5Fq4thwEz11fa/04vrt57RZ4jRhsOYfbtdQjOKm2qZCFk7ePXTLEG+PLACEHOLDER",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Cérebro Pro", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["tabs", "scripting", "storage", "alarms", "debugger", "tabGroups", "webNavigation", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["https://remoto.rangeltech.net/*"], "js": ["content-remoto.js"], "run_at": "document_idle" }
  ]
}
