{
	email contato@rangeltech.net
	# sites dos clientes (spec 69): certificado só para subdomínio registrado no rt-sites
	on_demand_tls {
		ask http://rt-sites:8090/ask
	}
}
nav.rangeltech.net {
	@wisp path /wisp /wisp/*
	handle @wisp {
		reverse_proxy wisp-relay:8080
	}
	handle {
		root * /srv
		header {
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Embedder-Policy require-corp
			Cross-Origin-Resource-Policy cross-origin
			Content-Security-Policy "frame-ancestors https://app.segundocerebro.pro https://remoto.rangeltech.net http://127.0.0.1:* http://localhost:*"
			X-Content-Type-Options nosniff
			-Server
		}
		@motor path /motor/*
		header @motor Cache-Control "public, max-age=31536000, immutable"
		@pagina path / /index.html
		header @pagina Cache-Control "no-cache"
		# o motor (.wasm, 150 MB) vai pré-compactado (zstd 34 MB / gzip 48 MB) e cru para o navegador compilar em streaming e guardar em cache
		encode zstd gzip
		file_server {
			precompressed zstd gzip
		}
	}
}

# API de publicação dos sites dos clientes (spec 69)
sites.rangeltech.net {
	reverse_proxy rt-sites:8090
}

# sites dos clientes: <nome>.rangeltech.net -> /sites/<nome>/ (nomes que já têm registro próprio no DNS nem chegam aqui)
https:// {
	tls {
		on_demand
	}
	# <site>.<cliente>.rangeltech.net -> /sites/<cliente>/<site>/ (um nível só)
	@sub header_regexp sub Host ^([a-z0-9-]{1,63})\.([a-z0-9-]{3,40})\.rangeltech\.net$
	handle @sub {
		root * /sites/{re.sub.2}/{re.sub.1}
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			-Server
		}
		encode zstd gzip
		try_files {path} {path}/index.html {path}.html =404
		file_server
	}
	@cliente header_regexp nome Host ^([a-z0-9-]{3,40})\.rangeltech\.net$
	handle @cliente {
		root * /sites/{re.nome.1}
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			-Server
		}
		@html path *.html /
		header @html Cache-Control "no-cache"
		encode zstd gzip
		try_files {path} {path}/index.html {path}.html =404
		file_server
	}
	handle {
		respond 404
	}
}

http:// {
	redir https://{host}{uri} 308
}
